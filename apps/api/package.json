{
  "name": "@lifeos/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LifeOS self-hosted Node API",
  "dependencies": {
    "@lifeos/core": "0.1.0",
    "sharp": "^0.35.4"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "start": "node --env-file-if-exists=../../.env dist/src/main.js",
    "test": "npm run build && node --test --test-isolation=none dist/test/api.test.js"
  }
}

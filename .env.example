# Copy this file to `.env`; `npm run dev` / `npm start` load it automatically
# (node --env-file-if-exists). Save it as UTF-8 *without* a BOM — with a BOM the
# first key name is mangled and silently ignored.
#
# Local development defaults to 127.0.0.1 and does not require a password.
LIFEOS_HOST=127.0.0.1
LIFEOS_PORT=3001
LIFEOS_DATA_DIR=./data
# LIFEOS_DB_PATH=./data/lifeos.sqlite

# Legacy single-user mode: required when LIFEOS_HOST is not loopback (Docker/NAS/cloud).
# In account mode, LIFEOS_PASSWORD is only the one-time owner bootstrap credential below.
# LIFEOS_PASSWORD=change-me

# Comma-separated Origin allowlist. These two are used by Vite in development.
# LIFEOS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# LIFEOS_WEB_PORT=5173 (only used by npm run dev when another Vite instance is active)
# LIFEOS_COOKIE_SECURE=false
# LIFEOS_BODY_LIMIT_BYTES=1048576

# Optional account mode for an HTTPS reverse-proxy deployment (e.g. Baota).
# For first boot, set account mode + owner username + a 10+ character password;
# after the owner exists in identity.sqlite, remove BOTH bootstrap variables and restart.
# LIFEOS_ACCOUNT_MODE=1
# LIFEOS_OWNER_USERNAME=owner
# LIFEOS_PASSWORD=replace-with-a-long-random-bootstrap-password
# LIFEOS_COOKIE_SECURE=true
# LIFEOS_ALLOWED_ORIGINS=https://lifeos.dnbox.cn
# LIFEOS_ASSET_ROOT=/data/assets
# LIFEOS_BACKUP_DIR=/data/backups
# Pin these four secrets before saving owner integration keys. Keep them stable across restarts.
# LIFEOS_AI_CONFIG_SECRET=replace-with-a-long-random-secret
# LIFEOS_WEATHER_CONFIG_SECRET=replace-with-a-long-random-secret
# LIFEOS_MOVIE_CONFIG_SECRET=replace-with-a-long-random-secret
# LIFEOS_BACKUP_CONFIG_SECRET=replace-with-a-long-random-secret

# Optional: local SQLite backup directory. Defaults to ${LIFEOS_DATA_DIR}/backups.
# LIFEOS_BACKUP_DIR=./data/backups

# Optional: S3-compatible object storage for database backups.
# Leave these unset to keep local-only backup mode. Credentials are read by the
# server process and are never returned by the status API or stored in browser state.
# BACKUP_S3_ENABLED=true
# BACKUP_S3_ENDPOINT=https://s3.amazonaws.com
# BACKUP_S3_REGION=us-east-1
# BACKUP_S3_BUCKET=your-bucket
# BACKUP_S3_PREFIX=backups/db
# BACKUP_S3_FORCE_PATH_STYLE=true
# BACKUP_S3_ACCESS_KEY_ID=your-access-key
# BACKUP_S3_SECRET_ACCESS_KEY=your-secret-key
# 整站异地备份必须显式指定确认私有的桶；不会自动沿用上面的普通单库备份桶。
# 上传前还会用无害探针拒绝可匿名读取的目标。不要填写公开 CDN 桶。
# LIFEOS_INSTANCE_BACKUP_S3_BUCKET=your-private-bucket
# 若专用桶使用另一套连接或密钥，单独覆盖这些值（均只在服务器 .env 中填写）：
# LIFEOS_INSTANCE_BACKUP_S3_ENDPOINT=https://s3.example.com
# LIFEOS_INSTANCE_BACKUP_S3_REGION=your-region
# LIFEOS_INSTANCE_BACKUP_S3_PREFIX=product-backup/lifeos
# LIFEOS_INSTANCE_BACKUP_S3_FORCE_PATH_STYLE=false
# LIFEOS_INSTANCE_BACKUP_S3_ACCESS_KEY_ID=your-private-bucket-access-key
# LIFEOS_INSTANCE_BACKUP_S3_SECRET_ACCESS_KEY=your-private-bucket-secret-key
# For Bitiful S4 / the reference `cdnb` bucket:
# BACKUP_S3_ENDPOINT=https://s3.bitiful.net
# BACKUP_S3_REGION=cn-east-1
# BACKUP_S3_BUCKET=cdnb
# BACKUP_S3_PREFIX=product-backup/lifeos
# BACKUP_S3_FORCE_PATH_STYLE=false
# Optional secret used to encrypt credentials saved from Settings:
# LIFEOS_BACKUP_CONFIG_SECRET=change-me

# Optional DeepSeek integration for summaries and the read-only assistant.
# Leave these unset to use local rule-based fallbacks.
# LIFEOS_DEEPSEEK_API_KEY=your-deepseek-api-key
# LIFEOS_DEEPSEEK_MODEL=deepseek-flash
# LIFEOS_DEEPSEEK_BASE_URL=https://api.deepseek.com
# Optional secret used to encrypt the API key saved from Settings:
# LIFEOS_AI_CONFIG_SECRET=change-me

# Optional QWeather integration for the header animation and date-based forecast.
# Leave these unset to configure weather from Settings instead.
# QWEATHER_KEY=your-qweather-api-key
# QWEATHER_LOCATION=101280601
# QWEATHER_CITY=珠海香洲
# QWEATHER_HOST=devapi.qweather.com
# Optional secret used to encrypt the API key saved from Settings:
# LIFEOS_WEATHER_CONFIG_SECRET=change-me

# Optional same-host 弹指 storage pool. Keep disabled until the deployment checks
# in docs/storage-pool-deployment.md pass. This starts the local PHP CLI worker;
# it does not expose a PHP endpoint or copy storage.php / the shared SQLite ledger.
# LIFEOS_STORAGE_POOL_ENABLED=1
# LIFEOS_POOL_CONSUMER=2
# LIFEOS_POOL_PHP_BINARY=/usr/bin/php
# LIFEOS_POOL_WORKER_PATH=/path/to/lifeos/apps/api/php/pool-consumer-worker.php
